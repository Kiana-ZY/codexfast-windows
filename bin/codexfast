                socket.write([
                    `GET ${path} HTTP/1.1`,
                    `Host: ${url.host}`,
                    "Upgrade: websocket",
                    "Connection: Upgrade",
                    `Sec-WebSocket-Key: ${key}`,
                    "Sec-WebSocket-Version: 13",
