            const socket = net.connect({ host: url.hostname, port });
            let handshakeBuffer = Buffer.alloc(0);
            let settled = false;
            const fail = (error) => {
                if (settled) {
                    return;
                }
                settled = true;
                socket.destroy();
                reject(error);
            };
            const timeout = setTimeout(() => {
                fail(new Error("Timed out during CDP WebSocket handshake."));
            }, 3_000);
            socket.once("connect", () => {
